# API image: runtime tsx (tanpa tsc terpisah agar build tidak rapuh).
# Seed idempotent (INSERT OR IGNORE) sehingga aman jalan tiap start.
FROM node:24-alpine
WORKDIR /app
COPY package.json ./
COPY apps/api/package.json apps/api/
# better-sqlite3 11.10.0 TIDAK punya prebuild untuk Node 24 + musl (terbukti
# 2026-10-26: "No prebuilt binaries found … libc=musl") → install jatuh ke
# `node-gyp rebuild` yang butuh python3/make/g++ — tanpa itu build image GAGAL
# ("Could not find any Python installation"). Toolchain dihapus lagi setelah
# npm install dalam layer yang sama supaya image tetap ramping; binary .node
# sudah terkompilasi dan libstdc++ tetap ada (dependensi node).
RUN apk add --no-cache --virtual .build-deps python3 make g++ \
 && npm install -w apps/api --no-audit --no-fund \
 && apk del .build-deps
# Path ABSOLUT: `../db/` (resolusi WORKDIR /app) mendarat di /db sementara
# db.ts mencari ../../db dari cwd /app/apps/api = /app/db — terbukti crash-loop
# 2026-10-26 "SQL file not found: schema.sql (tried /app/db/schema.sql, …)".
COPY db/ /app/db/
COPY apps/api/ apps/api/
WORKDIR /app/apps/api
# Hardening (2026-10-27): jalankan sebagai non-root (`node`, bawaan image) —
# bukan root seperti sebelumnya. `chown` /data ke user `node` karena volume
# bind-mount api-data harus bisa ditulis proses non-root. HEALTHCHECK disamakan
# dengan docker-compose.yml supaya `docker run` manual pun mendapat sinyal sehat.
RUN mkdir -p /data && chown -R node:node /app /data
ENV PORT=3001 DB_PATH=/data/data.db
EXPOSE 3001
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "fetch('http://localhost:'+process.env.PORT+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
USER node
CMD ["sh", "-c", "/app/node_modules/.bin/tsx src/seed.ts; /app/node_modules/.bin/tsx src/index.ts"]
