# Web static + proxy /api ke service api (same-origin, tanpa CORS drama)
#
# HTTPS LAN (butir ROADMAP 1.7, ACC pemilik 2026-10-25): pemindai barcode
# kamera HP (getUserMedia + BarcodeDetector) hanya jalan di KONTEKS AMAN —
# http://IP:5656 diblokir browser ("Kamera butuh koneksi aman"). Karena itu
# Caddy kini menyajikan HTTPS dengan sertifikat internal (self-signed):
#   1. Buka https://<ip-server>:5656 dari HP.
#   2. Peringatan sertifikat muncul SEKALI per perangkat — tap
#      "Lanjutkan ke situs (tidak aman)".
#   3. Kamera aktif; PWA & service worker ikut bisa dipasang.
# Alternatif tanpa peringatan: ekspor root CA Caddy
# (`docker compose exec web caddy trust --help` / file pki di volume) dan
# pasang di HP. Deteksi barcode & baca produk tetap 100% offline
# (cache IndexedDB) — sertifikat hanya men-buka gerbang kamera.
https://:5656 {
  # Sertifikat self-signed buatan sendiri (di-generate host sekali lalu
  # di-mount read-only, bukan `tls internal`).
  #
  # Alasan (terbukti 2026-10-27): `tls internal` TIDAK mem-buka handshake di
  # site address kosong `https://:5656` — Caddy memperlakukan host kosong
  # tanpa identifier, lalu menolak tiap ClientHello dengan
  # "no certificate available for 'localhost'" (alert internal error).
  # ACME/Let's Encrypt juga mustahil di sini (tak ada domain publik).
  #
  # File cert punya SAN eksplisit (localhost + IP LAN) sehingga perangkat
  # kasir yang mengakses via IP LAN mendapat sertifikat yang match. Peringatan
  # "tidak aman" muncul sekali per perangkat → tap "Lanjutkan ke situs".
  tls /certs/ravaa-selfsigned.crt /certs/ravaa-selfsigned.key
  # /api/* di-proxy ke API; semua sisanya = SPA (try_files + file_server).
  # KEDUANYA dibungkus `handle` terpisah (bukan root/file_server di level site):
  # root+file_server tanpa handle ikut men-serve request /api/* sebagai file
  # → SPA fallback /index.html, sehingga /api/* balik HTML, bukan JSON
  # (terbukti 2026-10-27: GET /api/me balik <doctype html>, login POST 405).
  @api path /api/*
  handle @api {
    reverse_proxy api:3001
  }
  handle {
    root * /srv
    try_files {path} /index.html
    file_server
  }
}
