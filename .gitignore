# Keluaran test: screenshot & tangkapan print-agent, dibuat ulang tiap run.
# tests/artifacts/.gitkeep tetap di-commit supaya foldernya ada di clone baru
# (beberapa suite menulis file ke situ tanpa mkdir).
tests/artifacts/*
!tests/artifacts/.gitkeep
