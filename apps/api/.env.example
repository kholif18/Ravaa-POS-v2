PORT=3001
DB_PATH=./data/data.db
# CORS ketat (2026-10-27): kosong = same-origin saja (cukup untuk deploy
# Docker/native — Caddy :5656 proxy /api → :3001, jadi origin = origin sendiri).
# Isi CSV origin asli HANYA bila ada host lintas-origin nyata, mis:
# CORS_ORIGIN=https://kasir.example,https://admin.example
# (nilai `*` TIDAK didukung — bukan wildcard, tapi daftar origin eksak.)
CASHIER_DEFAULT=kasir
